# Google OAuth web client ID configured for Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# YouTube Data API v3 key restricted to this app's allowed origins.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Optional verified Youtube channel ID; without it the app resolves the channel by name.
YOUTUBE_CHANNEL_ID=yout-youtube-chanel-id